@model List<ReadingDiary.Web.Models.Book>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📚 My Reading Diary</h1>

        <a asp-controller="Books"
           asp-action="Create"
           class="btn btn-primary">
            + Add Book
        </a>
    </div>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Search by title or author..." />

            <button class="btn btn-outline-secondary" type="submit">
                Search
            </button>
        </div>
    </form>

    <div class="row">

        @foreach (var book in Model)
        {
            var cardClass = book.Status switch
            {
                "Completed" => "border-success",
                "Reading" => "border-warning",
                "To Read" => "border-secondary",
                _ => "border-dark"
            };

            var badgeClass = book.Status switch
            {
                "Completed" => "bg-success",
                "Reading" => "bg-warning text-dark",
                "To Read" => "bg-secondary",
                _ => "bg-dark"
            };

            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card h-100 shadow-sm @cardClass">

                    <div class="card-body">

                        <div class="d-flex justify-content-between mb-3">

                            <h5 class="card-title mb-0">
                                @book.Title
                            </h5>

                            <span class="badge @badgeClass">
                                @book.Status
                            </span>

                        </div>

                        <h6 class="card-subtitle mb-3 text-muted">
                            @book.Author
                        </h6>

                        <p>
                            <strong>Progress:</strong>
                            @book.CurrentPage / @book.TotalPages
                        </p>

                        @{
                            var percentage = book.TotalPages > 0
                            ? book.CurrentPage * 100 / book.TotalPages
                            : 0;
                        }

                        <div class="progress mb-3">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width:@percentage%">
                                @percentage%
                            </div>

                        </div>

                        <p>
                            <strong>Rating:</strong>
                            ⭐ @book.Rating/5
                        </p>

                        @if (!string.IsNullOrWhiteSpace(book.Notes))
                        {
                            <p class="text-muted">
                                @book.Notes
                            </p>
                        }

                    </div>

                    <div class="card-footer bg-transparent">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@book.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@book.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
