@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">

    <div class="row align-items-center mb-5">

        <div class="col-lg-6">

            <h1 class="display-4 fw-bold">
                Your Personal Reading Diary
            </h1>

            <p class="lead text-muted">
                Track books you've read, are currently reading,
                or plan to read in the future.
            </p>

            <div class="mt-4">

                <a asp-controller="Books"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">

                    📚 View My Books

                </a>

                <a asp-controller="Books"
                   asp-action="Create"
                   class="btn btn-outline-secondary btn-lg ms-2">

                    ➕ Add Book

                </a>

            </div>

        </div>

        <div class="col-lg-6 text-center">

            <div class="display-1">
                📖
            </div>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card border-success shadow-sm">

                <div class="card-body text-center">

                    <h3 class="text-success">
                        ✅
                    </h3>

                    <h2>
                        @ViewBag.CompletedBooks
                    </h2>

                    <p class="mb-0">
                        Completed
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-warning shadow-sm">

                <div class="card-body text-center">

                    <h3>
                        📖
                    </h3>

                    <h2>
                        @ViewBag.ReadingBooks
                    </h2>

                    <p class="mb-0">
                        Reading
                    </p>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-secondary shadow-sm">

                <div class="card-body text-center">

                    <h3>
                        📚
                    </h3>

                    <h2>
                        @ViewBag.ToReadBooks
                    </h2>

                    <p class="mb-0">
                        To Read
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>